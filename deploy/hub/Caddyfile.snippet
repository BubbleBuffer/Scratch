# Add to /home/networking/caddy/templates/Caddyfile.template.
notes.breadcat.cc {
    import cloudflare
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
    reverse_proxy notes-hub:8080
}

# WebSockets pass through reverse_proxy by default; flush_interval -1 is unnecessary.
# Merge these entries into /home/networking/caddy/docker-compose.yml (keep existing networks):
# services:
#   caddy:
#     networks:
#       - notes-ingress
# networks:
#   notes-ingress:
#     external: true
