[Unit]
Description=Stopped notes-hub volume backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=notes-hub-backup
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/notes-hub-backup
Environment=BACKUP_DIR=/opt/notes-hub/backups
Environment=COMPOSE_FILE=/opt/notes-hub/compose.yaml
Environment=HUB_IMAGE=notes-hub:latest
EnvironmentFile=-/etc/notes-hub/backup.env
ExecStart=/usr/local/libexec/notes-hub/notes-hub-backup.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/notes-hub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
