# Copy to .env on the VPS and fill in the provider credentials.
NOTES_HUB_PUBLIC_URL=https://notes.breadcat.cc
NOTES_HUB_OIDC_ISSUER=https://<authentik-host>/application/o/notes-hub/
NOTES_HUB_OIDC_CLIENT_ID=replace-with-provider-client-id
NOTES_HUB_OIDC_CLIENT_SECRET=replace-with-provider-client-secret
NOTES_HUB_OIDC_ALLOWED_GROUPS=notes-users
# Optional: comma/space-separated users (email or sub), in addition to groups.
# NOTES_HUB_OIDC_ALLOWED_USERS=
# Container defaults: NOTES_HUB_LISTEN=0.0.0.0:8080, NOTES_HUB_DATA_DIR=/data.
# Leave the seeded /data/hub.toml empty to configure entirely through env vars.
